# Database Connection
# Connection string for your MongoDB database (e.g., MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/stock-marketplace

# Authentication (Better Auth)
# Secret key for signing session tokens (generate a secure random string)
BETTER_AUTH_SECRET=your_generated_secret_here
# Base URL of your application
BETTER_AUTH_URL=http://localhost:3000

# Email Service (Nodemailer)
# Email address used for sending system emails (e.g., auth codes)
NODEMAILER_EMAIL=your_email@gmail.com
# Application-specific password for the email account
NODEMAILER_PASSWORD=your_app_specific_password

# External APIs
# Finnhub Stock API (https://finnhub.io/)
# Public API key for client-side requests
NEXT_PUBLIC_FINNHUB_API_KEY=your_finnhub_api_key
# API key for server-side requests (usually the same as public)
FINNHUB_API_KEY=your_finnhub_api_key

# AI Integration (Google Gemini)
# API key for Gemini models
GEMINI_API_KEY=your_gemini_api_key
